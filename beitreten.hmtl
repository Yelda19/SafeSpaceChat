<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Safe Space - Beitreten</title>
</head>
<body>

    <h1>Willkommen im Safe Space Chat</h1>
    <p>Bitte gib deinen Namen ein, um dem Chat beizutreten:</p>

    <input id="nameInput" placeholder="Dein Name...">
    <button onclick="saveName()">Beitreten</button>

    <script>
    function saveName() {
        let eingabe = document.getElementById("nameInput").value;

        if (eingabe.trim() === "") {
            alert("Bitte gib einen gültigen Namen ein!");
            return;
        }

        localStorage.setItem("chatName", eingabe.trim());
        
        // Leitet den Nutzer zur Hauptseite weiter
        window.location.href = "index.html"; 
    }
    </script>

</body>
</html>
